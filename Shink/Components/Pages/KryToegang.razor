@page "/kry-toegang"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Schink Stories | Kry toegang</PageTitle>
<HeadContent>
    <meta name="description" content="@($"Sluit aan vir onbeperkte toegang tot al ons Afrikaanse oudiostories. Kies R{FormatAmount(MonthlyPlan.Amount)} per maand of R{FormatAmount(YearlyPlan.Amount)} per jaar.")" />
</HeadContent>

<section class="access-page">
    <input class="access-layout-input" type="checkbox" id="access-layout-toggle" role="switch" checked />
    <label class="access-layout-switch" for="access-layout-toggle">
        <span class="access-layout-track" aria-hidden="true"></span>
        <span>Planwisselaar</span>
    </label>
    <article class="access-card">
        <div class="access-card-content">
            <div class="access-brand">
                <img class="access-mascot" src="/branding/Oortjies_Kry_Toegang.png" alt=""
                     width="797" height="827" decoding="async" />
                <img class="access-logo" src="/branding/Schink_Stories_Logo_turqoise.webp" alt="Schink Stories"
                     width="983" height="428" decoding="async" />
            </div>

            <h1>Sluit aan vir onbeperkte toegang tot al ons stories.</h1>

            <ul class="access-benefits">
                <li><strong>120+</strong> Afrikaanse oudiostories</li>
                <li>Opbouende waardes en lewenslesse</li>
                <li><strong>Geen</strong> advertensies</li>
                <li><strong>Geen</strong> donker temas</li>
                <li>Aflaaibare aktiwiteite</li>
                <li>Toegang tot <strong>Schink Stories-toep</strong></li>
                <li><strong>Nuwe stories</strong> elke maand</li>
            </ul>

            <fieldset class="access-plans access-plans-toggle">
                <legend>Kies ’n plan</legend>
                <input class="access-billing-input access-billing-monthly" type="radio" name="access-billing-period"
                       id="access-billing-monthly" checked />
                <input class="access-billing-input access-billing-yearly" type="radio" name="access-billing-period"
                       id="access-billing-yearly" />
                <div class="access-billing-toggle">
                    <label class="access-billing-monthly-label" for="access-billing-monthly">Maandeliks</label>
                    <label class="access-billing-yearly-label" for="access-billing-yearly">Jaarliks</label>
                </div>
                <div class="access-plan-details">
                    <div class="access-plan-detail access-plan-monthly-detail">
                        <p class="access-price"><strong>R @FormatAmount(MonthlyPlan.Amount)</strong><span>/maand</span></p>
                        <p class="access-plan-note">Onbeperkte stories, elke maand.</p>
                        <a class="access-plan" href="@MonthlyCheckoutHref" data-enhance-nav="false"
                           aria-label="@($"Kry volle toegang teen R{FormatAmount(MonthlyPlan.Amount)} per maand")">Kry toegang</a>
                    </div>
                    <div class="access-plan-detail access-plan-yearly-detail">
                        <p class="access-price"><strong>R @FormatAmount(YearlyPlan.Amount)</strong><span>/jaar</span></p>
                        <p class="access-plan-note access-saving">@FreeMonths maande <strong>gratis</strong></p>
                        <a class="access-plan" href="@YearlyCheckoutHref" data-enhance-nav="false"
                           aria-label="@($"Kry volle toegang teen R{FormatAmount(YearlyPlan.Amount)} per jaar")">Kry toegang</a>
                    </div>
                </div>
                <p class="access-cancellation">Geen kontrak. Kanselleer enige tyd.</p>
            </fieldset>
            <div class="access-plans access-plans-buttons">
                <h2>Kies ’n plan</h2>
                <a class="access-plan access-plan-monthly" href="@MonthlyCheckoutHref" data-enhance-nav="false"
                   aria-label="@($"Kies volle toegang teen R{FormatAmount(MonthlyPlan.Amount)} per maand")">
                    <strong>R @FormatAmount(MonthlyPlan.Amount)</strong><span>/maand</span>
                </a>
                <p class="access-cancellation">Geen kontrak. Kanselleer enige tyd.</p>
                <a class="access-plan access-plan-yearly" href="@YearlyCheckoutHref" data-enhance-nav="false"
                   aria-label="@($"Kies volle toegang teen R{FormatAmount(YearlyPlan.Amount)} per jaar")">
                    <span><strong>R @FormatAmount(YearlyPlan.Amount)</strong> per jaar <span class="access-button-saving">( @FreeMonths maande <strong>gratis</strong> )</span></span>
                </a>
            </div>
        </div>
    </article>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private static readonly PaymentPlan MonthlyPlan = PaymentPlanCatalog.FindBySlug("schink-stories-maandeliks")!;
    private static readonly PaymentPlan YearlyPlan = PaymentPlanCatalog.FindBySlug("schink-stories-jaarliks")!;
    private bool IsAuthenticated { get; set; }
    private string MonthlyCheckoutHref => StoryAccessCheckoutLinks.BuildCheckoutHref(MonthlyPlan, IsAuthenticated, ReturnUrl);
    private string YearlyCheckoutHref => StoryAccessCheckoutLinks.BuildCheckoutHref(YearlyPlan, IsAuthenticated, ReturnUrl);
    private static int FreeMonths => (int)(YearlyPlan.BillingPeriodMonths - YearlyPlan.Amount / MonthlyPlan.Amount);
    private static string FormatAmount(decimal amount) => amount.ToString("0.##", CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        IsAuthenticated = authState.User.Identity?.IsAuthenticated == true;
    }
}
