@page "/winkel"
@page "/winkel/mandjie"
@page "/winkel/afreken"
@page "/winkel/produk/{ProductSlug}"
@using Shink.Components.Store

<PageTitle>@PageHeading | Schink Stories</PageTitle>
<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    <meta name="description" content="@MetaDescription" />
    @if (View is "cart" or "checkout" || HasPaymentStatus || (View == "product" && Product is null))
    {
        <meta name="robots" content="noindex, follow" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@($"{PageHeading} | Schink Stories")" />
    <meta property="og:description" content="@MetaDescription" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:image" content="@ImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@($"{PageHeading} | Schink Stories")" />
    <meta name="twitter:description" content="@MetaDescription" />
    <meta name="twitter:image" content="@ImageUrl" />
    <JsonLdScript Json="@StoreJsonLd" />
</HeadContent>

<section class="winkel-page" data-store data-store-view="@View" data-store-delivery-cents="@StoreCheckoutRules.ToCents(StoreCheckoutRules.DeliveryFeeZar)"
         data-store-render-id="@_analyticsPageId" data-store-detail-slug="@(View == "product" ? Product?.Slug : null)"
         data-store-max-per-product="@StoreCheckoutRules.MaxPerProduct" data-store-max-items="@StoreCheckoutRules.MaxItems"
         data-store-completed-reference="@(IsVerifiedPaid ? VerifiedOrder!.OrderReference : null)"
         data-store-completed-checkout-id="@(IsVerifiedPaid ? CompletedCheckoutId : null)">
    <StoreShell Products="Products" />
    @if (VerifiedOrder is not null && (IsVerifiedPaid || PaymentStatus is "verwerk" or "sukses"))
    {
        <StoreReceipt Order="VerifiedOrder" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(PaymentMessage))
        {
            <div class="winkel-payment-status @(PaymentStatus == "misluk" ? "is-error" : "is-processing")" role="status">
                <p>@PaymentMessage</p>
                @if (!string.IsNullOrWhiteSpace(OrderReference))
                {
                    <p>Bestelverwysing: @OrderReference[..Math.Min(OrderReference.Length, 80)]</p>
                }
                <a href="/winkel/afreken">Terug na betaalpunt</a>
            </div>
        }
        @if (View == "cart")
        {
            <StoreBasket Products="Products" />
        }
        else if (View == "checkout")
        {
            <StoreCheckout Products="Products" Details="CheckoutDetails" AccountEmail="@CheckoutAccountEmail" />
        }
        else if (View == "product")
        {
            @if (Product is not null)
            {
                <StoreProductDetail Product="Product" />
            }
            else
            {
                <div class="winkel-empty"><h1>Hierdie maatjie is nie tans beskikbaar nie.</h1><p>Ontdek die ander StorieTjommies in ons winkel.</p><a class="winkel-submit" href="/winkel">Gaan winkel toe</a></div>
            }
        }
        else
        {
            <StoreCatalog Products="Products" />
        }
    }
</section>
