    private void MoveBlock(Guid blockId, int direction)
    {
        if (_workingContent is null)
        {
            return;
        }

        var index = _workingContent.Blocks.FindIndex(block => block.Id == blockId);
        var destination = index + direction;
        if (index < 0 || destination < 0 || destination >= _workingContent.Blocks.Count)
        {
            return;
        }

        var block = _workingContent.Blocks[index];
        _workingContent.Blocks.RemoveAt(index);
        _workingContent.Blocks.Insert(destination, block);
        MarkChanged();
    }

