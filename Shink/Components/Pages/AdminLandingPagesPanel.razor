    private async Task UploadImageAsync(LandingPageBlock block, InputFileChangeEventArgs args)
    {
        if (_workingContent is null)
        {
            return;
        }

        var file = args.File;
        _errorMessage = null;
        _statusMessage = null;

        if (file.Size is <= 0 or > MaxImageUploadBytes)
        {
            _errorMessage = T("Kies 'n JPEG-, PNG- of WebP-prent van hoogstens 10 MB.", "Choose a JPEG, PNG, or WebP image no larger than 10 MB.");
            return;
        }

        _isUploadingImage = true;
        try
        {
            if (!await LandingPageAdminService.EnsureAdminAsync())
            {
                _errorMessage = T("Jou adminregte is nie bevestig nie. Die prent is nie opgelaai nie.", "Your admin access could not be confirmed. The image was not uploaded.");
                return;
            }

            if (!IsR2UploadConfigured)
            {
                _errorMessage = T("Cloudflare R2 is nie opgestel vir prentoplaaie nie.", "Cloudflare R2 is not configured for image uploads.");
                return;
            }

            var image = await ValidateAndNormalizeImageAsync(file, CancellationToken.None);
            var pageScopeId = _selectedPageId ?? _newDraftAssetScopeId;
            await using var content = image.Content;
            var uploaded = await StoryMediaStorageService.UploadImageAsync(
                $"landing-{pageScopeId:N}-{block.Id:N}",
                StoryImageKind.Inline,
                $"landing-{block.Id:N}{image.Extension}",
                image.ContentType,
                content,
                CancellationToken.None);

            block.ImageUrl = uploaded.PublicUrl;
            MarkChanged();
            _statusMessage = T("Die prent is opgelaai. Stoor die konsep om die bladsyverandering te behou.", "The image is uploaded. Save the draft to keep this page change.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Landing page image upload failed for block {BlockId}.", block.Id);
            _errorMessage = GetOperationError(exception, T("Die prent kon nie opgelaai word nie.", "The image could not be uploaded."));
        }
        finally
        {
            _isUploadingImage = false;
        }
    }

    private static async Task<ValidatedLandingImage> ValidateAndNormalizeImageAsync(IBrowserFile file, CancellationToken cancellationToken)
    {
        await using var source = file.OpenReadStream(MaxImageUploadBytes, cancellationToken);
        var buffer = new MemoryStream(checked((int)file.Size));
        try
        {
            await source.CopyToAsync(buffer, cancellationToken);
            buffer.Position = 0;

            var decoderOptions = new SixLabors.ImageSharp.Formats.DecoderOptions
            {
                MaxFrames = 1,
                SkipMetadata = true
            };
            var format = await Image.DetectFormatAsync(decoderOptions, buffer, cancellationToken);
            if (format is null ||
                (format != JpegFormat.Instance && format != PngFormat.Instance && format != WebpFormat.Instance))
            {
                throw new InvalidOperationException("unsupported_image_format");
            }

            buffer.Position = 0;
            var imageInfo = await Image.IdentifyAsync(decoderOptions, buffer, cancellationToken);
            if (imageInfo is null || imageInfo.Width <= 0 || imageInfo.Height <= 0 ||
                (long)imageInfo.Width * imageInfo.Height > MaxImagePixelCount)
            {
                throw new InvalidOperationException("image_dimensions_invalid");
            }

            buffer.Position = 0;
            using var decoded = await Image.LoadAsync<Rgba32>(decoderOptions, buffer, cancellationToken);
            if (decoded.Width != imageInfo.Width || decoded.Height != imageInfo.Height)
            {
                throw new InvalidOperationException("image_decode_failed");
            }

            var (contentType, extension) = format == JpegFormat.Instance
                ? ("image/jpeg", ".jpg")
                : format == PngFormat.Instance
                    ? ("image/png", ".png")
                    : ("image/webp", ".webp");

            buffer.Position = 0;
            return new ValidatedLandingImage(buffer, contentType, extension);
        }
        catch
        {
            await buffer.DisposeAsync();
            throw;
        }
    }

    private async Task SaveDraftAsync()
    {
        if (_workingContent is null || !_hasUnsavedChanges || IsBusy)
        {
            return;
        }

        _errorMessage = null;
        _statusMessage = null;
        if (string.IsNullOrWhiteSpace(_workingSlug))
        {
            _errorMessage = T("Voer 'n geldige URL-slug in voordat jy stoor.", "Enter a valid URL slug before saving.");
            return;
        }

        _isSaving = true;
        try
        {
            var result = await LandingPageAdminService.SaveDraftAsync(
                new LandingPageSaveRequest(_selectedPageId, _workingSlug.Trim(), CloneContent(_workingContent), _workingRevision));
            if (!result.Success || result.Page is null)
            {
                _errorMessage = GetResultError(result.ErrorCode, T("Die konsep kon nie gestoor word nie.", "The draft could not be saved."));
                return;
            }

            ReplacePage(result.Page);
            _statusMessage = T("Konsep gestoor.", "Draft saved.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Landing page draft save failed for {PageId}.", _selectedPageId);
            _errorMessage = GetOperationError(exception, T("Die konsep kon nie gestoor word nie.", "The draft could not be saved."));
        }
        finally
        {
            _isSaving = false;
        }
    }

