    private async Task DeleteAsync()
    {
        if (_selectedPage is null || IsBusy || HasUnsavedChanges) return;
        var page = _selectedPage;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", T(
            $"Verwyder '{page.Draft.Title}'? Dit sal uit die lys verdwyn en die openbare skakel sal nie meer werk nie.",
            $"Delete '{page.Draft.Title}'? It will disappear from the list and its public URL will no longer work."))) return;
        _isDeleting = true;
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            var result = await LandingPageAdminService.DeleteAsync(page.PageId, page.Revision);
            if (!result.Success)
            {
                _errorMessage = GetResultError(result.ErrorCode, T("Die bladsy kon nie verwyder word nie.", "The page could not be deleted."));
                return;
            }
            _pages = _pages.Where(existing => existing.PageId != page.PageId).ToArray();
            _selectedPage = null;
            _selectedPageId = null;
            _workingRevision = null;
            _workingContent = null;
            _workingSlug = string.Empty;
            _activeTextBlockId = null;
            _richTextEditorSyncPending = false;
            _hasUnsavedChanges = false;
            _statusMessage = T("Die bladsy is verwyder.", "The page has been deleted.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Landing page deletion failed for {PageId}.", page.PageId);
            _errorMessage = GetOperationError(exception, T("Die bladsy kon nie verwyder word nie.", "The page could not be deleted."));
        }
        finally { _isDeleting = false; }
    }

    private void ReplacePage(LandingPageRecord page)
    {
        _pages = _pages.Where(existing => existing.PageId != page.PageId).Append(page).ToArray();
        LoadPage(page);
    }

    private string GetBlockTitle(LandingPageBlock block) => block.Type.ToLowerInvariant() switch
    {
        "image" => T("Prentblok", "Image block"),
        "button" => T("Knoppieblok", "Button block"),
        _ => T("Teksblok", "Text block")
    };

    private string GetBlockSummary(LandingPageBlock block) => block.Type.ToLowerInvariant() switch
    {
        "image" => string.IsNullOrWhiteSpace(block.ImageUrl) ? T("Geen prent opgelaai nie", "No image uploaded") : string.IsNullOrWhiteSpace(block.AltText) ? T("Prent opgelaai", "Image uploaded") : block.AltText,
        "button" => string.IsNullOrWhiteSpace(block.Text) ? T("Nuwe knoppie", "New button") : block.Text,
        _ => GetTextBlockSummary(block)
    };

    private string GetTextBlockSummary(LandingPageBlock block)
    {
        var text = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(block.Html ?? string.Empty, "<[^>]+>", " "));
        text = string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return text.Length > 55 ? $"{text[..52]}…" : string.IsNullOrWhiteSpace(text) ? T("Leë teksblok", "Empty text block") : text;
    }

