    private readonly Dictionary<Guid, string> _customButtonUrls = new();
    private readonly Dictionary<Guid, string> _subscriptionButtonUrls = new();

    private string GetButtonLinkType(LandingPageBlock block) =>
        block.LinkType is "custom" or "subscription" ? block.LinkType :
        LandingPageButtonLinks.GetSubscriptionSlug(block.Url) is null ? "custom" : "subscription";

    private void SetButtonLinkType(LandingPageBlock block, string? type)
    {
        var nextType = type == "subscription" ? "subscription" : "custom";
        if (GetButtonLinkType(block) == nextType) return;
        if (nextType == "subscription")
        {
            _customButtonUrls[block.Id] = block.Url;
            block.Url = _subscriptionButtonUrls.GetValueOrDefault(block.Id, string.Empty);
        }
        else
        {
            _subscriptionButtonUrls[block.Id] = block.Url;
            block.Url = _customButtonUrls.GetValueOrDefault(block.Id, block.Url);
        }
        block.LinkType = nextType;
        MarkChanged();
    }

