    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_richTextEditorModule is not null)
        {
            try
            {
                await _richTextEditorModule.InvokeVoidAsync("setRichTextEditorDisabled", _richTextEditorShell, IsBusy);
            }
            catch (JSDisconnectedException)
            {
                return;
            }
        }

        if (_workingContent is null || ActiveTextBlock is null || !_richTextEditorSyncPending)
        {
            return;
        }

        try
        {
            _richTextEditorModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/Components/Pages/AdminLandingPagesPanel.razor.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _richTextEditorModule.InvokeVoidAsync("syncRichTextEditor", _richTextEditorShell, _dotNetReference, ActiveTextBlock.Html, IsBusy);
            _richTextEditorSyncPending = false;
            _richTextEditorFailed = false;
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            _richTextEditorSyncPending = false;
            _richTextEditorFailed = true;
            Logger.LogWarning(exception, "The landing page rich text editor could not be initialized.");
            _errorMessage = T("Die teksredigeerder kon nie oopmaak nie. Verfris die bladsy en probeer weer.", "The text editor could not open. Refresh the page and try again.");
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task<bool> ConfirmDiscardAsync()
    {
        if (!HasUnsavedChanges)
        {
            return true;
        }

        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                T("Jy het ongestoorde landingsbladveranderinge. Is jy seker jy wil dit weggooi?", "You have unsaved landing page changes. Are you sure you want to discard them?"));
            if (confirmed)
            {
                _hasUnsavedChanges = false;
            }

            return confirmed;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Landing page discard confirmation could not be displayed.");
            return false;
        }
    }

