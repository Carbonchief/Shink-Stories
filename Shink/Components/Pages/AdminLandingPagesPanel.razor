@implements IAsyncDisposable
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Shink.Components.Shared
@using Shink.Services
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Formats.Jpeg
@using SixLabors.ImageSharp.Formats.Png
@using SixLabors.ImageSharp.Formats.Webp
@using SixLabors.ImageSharp.PixelFormats
@inject ILandingPageAdminService LandingPageAdminService
@inject IStoryMediaStorageService StoryMediaStorageService
@inject IOptions<CloudflareR2Options> CloudflareR2OptionsAccessor
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<AdminLandingPagesPanel> Logger

<NavigationLock ConfirmExternalNavigation="HasUnsavedChanges" />

<section class="landing-admin" aria-label='@T("Landingsbladbestuur", "Landing page management")'>
    <header class="landing-admin-heading">
        <div>
            <h2>@T("Landingsbladsye", "Landing pages")</h2>
            <p>@T("Skep en bestuur bemarkingsbladsye met 'n eenvoudige blokredigeerder.", "Create and manage marketing pages with a simple block editor.")</p>
        </div>
        <button type="button" class="landing-primary-button" @onclick="StartNewPageAsync" disabled="@IsBusy">
            <span aria-hidden="true">＋</span> @T("Nuwe bladsy", "New page")
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="landing-notice landing-notice-error" role="alert">@_errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="landing-notice landing-notice-success" role="status" aria-live="polite">@_statusMessage</div>
    }

    @if (_isLoading)
    {
        <div class="landing-loading" role="status">@T("Laai landingsbladsye...", "Loading landing pages...")</div>
    }
    else if (_loadFailed)
    {
        <div class="landing-empty-state" role="alert">
            <h3>@T("Landingsbladsye kon nie laai nie", "Landing pages could not be loaded")</h3>
            <button type="button" class="landing-secondary-button" @onclick="ReloadAsync">@T("Probeer weer", "Try again")</button>
        </div>
    }
    else if (!_isAuthorized)
    {
        <div class="landing-empty-state" role="alert">
            <h3>@T("Toegang geweier", "Access denied")</h3>
            <p>@T("Jou rekening het nie adminregte vir landingsbladsye nie.", "Your account does not have admin access to landing pages.")</p>
        </div>
    }
    else
    {
        <div class="landing-admin-layout">
            <aside class="landing-page-list" aria-label='@T("Landingsbladsye", "Landing pages")'>
                <div class="landing-list-controls">
                    <label class="landing-field">
                        <span>@T("Soek", "Search")</span>
                        <input type="search" value="@_searchText" @oninput="OnSearchInput" placeholder='@T("Titel of slug", "Title or slug")' />
                    </label>
                    <label class="landing-field">
                        <span>@T("Wys", "Show")</span>
                        <select value="@_statusFilter" @onchange="OnStatusFilterChanged">
                            <option value="all">@T("Alles", "All")</option>
                            <option value="draft">@T("Konsep", "Draft")</option>
                            <option value="published">@T("Gepubliseer", "Published")</option>
                            <option value="changes">@T("Ongepubliseerde veranderinge", "Unpublished changes")</option>
                        </select>
                    </label>
                </div>

                @if (FilteredPages.Count == 0)
                {
                    <div class="landing-list-empty">
                        @(_pages.Count == 0
                            ? T("Geen landingsbladsye is geskep nie.", "No landing pages have been created.")
                            : T("Geen bladsye pas by jou filters nie.", "No pages match these filters."))
                    </div>
                }
                else
                {
                    <ul class="landing-page-items">
                        @foreach (var page in FilteredPages)
                        {
                            <li>
                                <button type="button"
                                        class="landing-page-item @GetPageItemClass(page)"
                                        aria-current="@(_selectedPageId == page.PageId ? "true" : null)"
                                        @onclick="() => SelectPageAsync(page)"
                                        disabled="@IsBusy">
                                    <span class="landing-page-item-title">@(string.IsNullOrWhiteSpace(page.Draft.Title) ? T("Naamlose bladsy", "Untitled page") : page.Draft.Title)</span>
                                    <span class="landing-page-item-slug">/veldtog/@(page.Slug)</span>
                                    <span class="landing-status @GetStatusClass(page)">@GetStatusLabel(page)</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </aside>

            <div class="landing-editor-column" inert="@IsBusy">
                @if (_workingContent is null)
                {
                    <div class="landing-empty-state landing-select-state">
                        <h3>@T("Kies 'n bladsy of begin nuut", "Choose a page or start a new one")</h3>
                        <p>@T("Jou konsepte en gepubliseerde bladsye verskyn hier.", "Your drafts and published pages will appear here.")</p>
                    </div>
                }
                else
                {
                    <div class="landing-editor-toolbar">
                        <div>
                            <p class="landing-eyebrow">@(_selectedPageId is null ? T("Nuwe bladsy", "New page") : GetStatusLabel(_selectedPage!))</p>
                            @if (HasUnsavedChanges)
                            {
                                <span class="landing-dirty-indicator"><span aria-hidden="true">●</span> @T("Ongestoor", "Unsaved")</span>
                            }
                            @if (_selectedPage is { IsPublished: true })
                            {
                                <a class="landing-public-page-link" href="@($"/veldtog/{_selectedPage.Slug}")" target="_blank" rel="noopener noreferrer">@T("Maak openbare bladsy oop", "Open public page")</a>
                                <button type="button" class="landing-secondary-button" @onclick="CopyUrlAsync">@T("Kopieer skakel", "Copy URL")</button>
                                <input class="landing-public-url" aria-label='@T("Gepubliseerde skakel", "Published URL")' readonly value="@PublishedUrl" />
                            }
                        </div>
                        <div class="landing-editor-actions">
                            <button type="button" class="landing-secondary-button" @onclick="SaveDraftAsync" disabled="@(IsBusy || !HasUnsavedChanges)">
                                @(IsSaving ? T("Stoor...", "Saving...") : T("Stoor konsep", "Save draft"))
                            </button>
                            @if (_selectedPage is { IsPublished: true })
                            {
                                @if (_selectedPage.HasUnpublishedChanges)
                                {
                                    <button type="button" class="landing-primary-button" @onclick="PublishAsync" disabled="@(!CanPublish)">
                                        @(IsPublishing ? T("Publiseer...", "Publishing...") : T("Werk regstreeks by", "Update live page"))
                                    </button>
                                }
                                <button type="button" class="landing-warning-button" @onclick="UnpublishAsync" disabled="@(IsBusy || _hasUnsavedChanges)">
                                    @(IsUnpublishing ? T("Ontpubliseer...", "Unpublishing...") : T("Ontpubliseer", "Unpublish"))
                                </button>
                            }
                            else
                            {
                                <button type="button" class="landing-primary-button" @onclick="PublishAsync" disabled="@(!CanPublish)">
                                    @(IsPublishing ? T("Publiseer...", "Publishing...") : T("Publiseer", "Publish"))
                                </button>
                            }
                            @if (_selectedPage is not null)
                            {
                                <button type="button" class="landing-warning-button" @onclick="DeleteAsync" disabled="@(IsBusy || HasUnsavedChanges)">
                                    @(_isDeleting ? T("Verwyder...", "Deleting...") : T("Verwyder bladsy", "Delete page"))
                                </button>
                            }
                        </div>
                    </div>

                    <div class="landing-editor-grid">
                        <div class="landing-editor-form">
                            <section class="landing-card">
                                <div class="landing-card-heading">
                                    <div>
                                        <h3>@T("Bladsybesonderhede", "Page details")</h3>
                                        <p>@T("Titel, adres en sosiale deelteks.", "Title, address, and social sharing text.")</p>
                                    </div>
                                </div>
                                <label class="landing-field">
                                    <span>@T("Bladsytitel", "Page title")</span>
                                    <input type="text" maxlength="160" @bind="_workingContent.Title" @bind:after="OnTitleChangedAsync" />
                                </label>
                                <label class="landing-field">
                                    <span>@T("URL-slug", "URL slug")</span>
                                    <div class="landing-slug-input"><span aria-hidden="true">/veldtog/</span><input type="text" maxlength="100" value="@_workingSlug" @oninput="OnSlugInput" disabled="@IsSlugLocked" /></div>
                                    @if (IsSlugLocked)
                                    {
                                        <small>@T("Die slug is vas omdat hierdie bladsy reeds gepubliseer is.", "The slug is fixed because this page has been published before.")</small>
                                    }
                                </label>
                                <label class="landing-field">
                                    <span>@T("Deeltitel", "Sharing title")</span>
                                    <input type="text" maxlength="160" @bind="_workingContent.SharingTitle" @bind:after="MarkChanged" />
                                </label>
                                <label class="landing-field">
                                    <span>@T("Deelbeskrywing", "Sharing description")</span>
                                    <textarea rows="3" maxlength="320" @bind="_workingContent.SharingDescription" @bind:after="MarkChanged"></textarea>
                                </label>
                                <div class="landing-color-row">
                                    <label class="landing-field landing-color-field">
                                        <span>@T("Agtergrondkleur", "Background color")</span>
                                        <input type="color" value="@ColorOrDefault(_workingContent.BackgroundColor, "#ff7133")" @onchange="SetPageBackgroundColor" />
                                    </label>
                                    <label class="landing-field landing-color-field">
                                        <span>@T("Tekskleur", "Text color")</span>
                                        <input type="color" value="@ColorOrDefault(_workingContent.TextColor, "#ffffff")" @onchange="SetPageTextColor" />
                                    </label>
                                </div>
                            </section>

                            <section class="landing-card landing-blocks-card">
                                <div class="landing-card-heading landing-card-heading-wrap">
                                    <div>
                                        <h3>@T("Blokke", "Blocks")</h3>
                                        <p>@T("Voeg inhoud by en verander die volgorde.", "Add content and change its order.")</p>
                                    </div>
                                    <div class="landing-add-block-actions">
                                        <button type="button" class="landing-small-button" @onclick="AddImageBlock">@T("＋ Prent", "+ Image")</button>
                                        <button type="button" class="landing-small-button" @onclick="AddTextBlock">@T("＋ Teks", "+ Text")</button>
                                        <button type="button" class="landing-small-button" @onclick="AddButtonBlock">@T("＋ Knoppie", "+ Button")</button>
                                    </div>
                                </div>

                                @if (_workingContent.Blocks.Count == 0)
                                {
                                    <div class="landing-list-empty">@T("Voeg 'n prent-, teks- of knoppieblok by.", "Add an image, text, or button block.")</div>
                                }
                                else
                                {
                                    <ol class="landing-block-list">
                                        @for (var index = 0; index < _workingContent.Blocks.Count; index++)
                                        {
                                            var block = _workingContent.Blocks[index];
                                            <li class="landing-block-card">
                                                <div class="landing-block-heading">
                                                    <div class="landing-block-heading-copy">
                                                        <span class="landing-block-index">@(index + 1)</span>
                                                        <div>
                                                            <h4>@GetBlockTitle(block)</h4>
                                                            <p>@GetBlockSummary(block)</p>
                                                        </div>
                                                    </div>
                                                    <div class="landing-block-actions">
                                                        <button type="button" title='@T("Skuif op", "Move up")' aria-label='@T("Skuif blok op", "Move block up")' @onclick="() => MoveBlock(block.Id, -1)" disabled="@(index == 0)">↑</button>
                                                        <button type="button" title='@T("Skuif af", "Move down")' aria-label='@T("Skuif blok af", "Move block down")' @onclick="() => MoveBlock(block.Id, 1)" disabled="@(index == _workingContent.Blocks.Count - 1)">↓</button>
                                                        @if (string.Equals(block.Type, "text", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <button type="button" class="landing-edit-block" @onclick="() => SelectTextBlock(block.Id)">@T("Redigeer teks", "Edit text")</button>
                                                        }
                                                        <button type="button" class="landing-remove-block" @onclick="() => RemoveBlockAsync(block)">@T("Verwyder", "Remove")</button>
                                                    </div>
                                                </div>

                                                @if (string.Equals(block.Type, "image", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="landing-block-fields">
                                                        @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                                                        {
                                                            <img class="landing-block-image-preview" src="@block.ImageUrl" alt="@block.AltText" />
                                                        }
                                                        <label class="landing-field">
                                                            <span>@T("Laai prent op", "Upload image")</span>
                                                            <InputFile OnChange="@(args => UploadImageAsync(block, args))" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" disabled="@(IsBusy || IsUploadingImage)" />
                                                            <small>@T("JPEG, PNG of WebP; maksimum 10 MB.", "JPEG, PNG, or WebP; maximum 10 MB.")</small>
                                                        </label>
                                                        <label class="landing-field">
                                                            <span>@T("Alternatiewe teks", "Alternative text")</span>
                                                            <input type="text" maxlength="250" @bind="block.AltText" @bind:after="MarkChanged" />
                                                        </label>
                                                        <label class="landing-field">
                                                            <span>@T("Prentskakel (opsioneel)", "Image link (optional)")</span>
                                                            <input type="text" maxlength="2048" @bind="block.Url" @bind:after="MarkChanged" placeholder="https://... or /luister" />
                                                        </label>
                                                        <label class="landing-field">
                                                            <span>@T("Vorm", "Shape")</span>
                                                            <select value="@block.ImageShape" @onchange="args => SetImageShape(block, args.Value?.ToString())">
                                                                <option value="square">@T("Vierkant", "Square")</option>
                                                                <option value="natural">@T("Natuurlike verhouding", "Natural aspect ratio")</option>
                                                            </select>
                                                        </label>
                                                        <label class="landing-field">
                                                            <span>@T("Belyning", "Alignment")</span>
                                                            <select value="@block.Alignment" @onchange="args => SetBlockAlignment(block, args.Value?.ToString())">
                                                                <option value="left">@T("Links", "Left")</option>
                                                                <option value="center">@T("Middel", "Center")</option>
                                                                <option value="right">@T("Regs", "Right")</option>
                                                            </select>
                                                        </label>
                                                        @if (IsUploadingImage)
                                                        {
                                                            <p class="landing-inline-status" role="status">@T("Laai prent op...", "Uploading image...")</p>
                                                        }
                                                    </div>
                                                }
                                                else if (string.Equals(block.Type, "button", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="landing-block-fields">
                                                        <label class="landing-field">
                                                            <span>@T("Knoppieteks", "Button text")</span>
                                                            <input type="text" maxlength="100" @bind="block.Text" @bind:after="MarkChanged" />
                                                        </label>
                                                        <label class="landing-field">
                                                            <span>@T("Skakeltipe", "Link type")</span>
                                                            <select value="@GetButtonLinkType(block)" @onchange="args => SetButtonLinkType(block, args.Value?.ToString())">
                                                                <option value="custom">@T("Pasgemaakte skakel", "Custom URL")</option>
                                                                <option value="subscription">@T("Intekeningopsie", "Subscription option")</option>
                                                            </select>
                                                        </label>
                                                        @if (GetButtonLinkType(block) == "subscription")
                                                        {
                                                            <label class="landing-field">
                                                                <span>@T("Intekeningopsie", "Subscription option")</span>
                                                                <select value="@(LandingPageButtonLinks.GetSubscriptionSlug(block.Url) ?? string.Empty)" @onchange="args => SetButtonSubscription(block, args.Value?.ToString())">
                                                                    <option value="">@T("Kies 'n intekeningopsie", "Choose a subscription option")</option>
                                                                    @foreach (var option in LandingPageButtonLinks.SubscriptionOptions)
                                                                    {
                                                                        <option value="@option.Slug">@GetSubscriptionLabel(option.Slug)</option>
                                                                    }
                                                                </select>
                                                            </label>
                                                        }
                                                        else
                                                        {
                                                            <label class="landing-field">
                                                                <span>@T("Skakel", "Link")</span>
                                                                <input type="text" maxlength="2048" @bind="block.Url" @bind:after="MarkChanged" placeholder="https://... or /luister" />
                                                            </label>
                                                        }
                                                        <div class="landing-color-row">
                                                            <label class="landing-field landing-color-field">
                                                                <span>@T("Knoppiekleur", "Button color")</span>
                                                                <input type="color" value="@ColorOrDefault(block.BackgroundColor, "#222222")" @onchange="args => SetButtonBackground(block, args.Value?.ToString())" />
                                                            </label>
                                                            <label class="landing-field landing-color-field">
                                                                <span>@T("Knoppietekskleur", "Button text color")</span>
                                                                <input type="color" value="@ColorOrDefault(block.TextColor, "#ffffff")" @onchange="args => SetButtonTextColor(block, args.Value?.ToString())" />
                                                            </label>
                                                        </div>
                                                        <label class="landing-field">
                                                            <span>@T("Belyning", "Alignment")</span>
                                                            <select value="@block.Alignment" @onchange="args => SetBlockAlignment(block, args.Value?.ToString())">
                                                                <option value="left">@T("Links", "Left")</option>
                                                                <option value="center">@T("Middel", "Center")</option>
                                                                <option value="right">@T("Regs", "Right")</option>
                                                            </select>
                                                        </label>
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ol>
                                }
                            </section>

                                <section class="landing-card landing-rich-text-card" hidden="@(TextBlocks.Count == 0)">
                                    <div class="landing-card-heading">
                                        <div>
                                            <h3>@T("Teksredigeerder", "Text editor")</h3>
                                            <p>@T("Gebruik opskrifte, vetdruk, kursief, skakels, lyste en belyning.", "Use headings, bold, italic, links, lists, and alignment.")</p>
                                        </div>
                                    </div>
                                    <label class="landing-field">
                                        <span>@T("Teksblok", "Text block")</span>
                                        <select value="@(_activeTextBlockId?.ToString("N") ?? string.Empty)" @onchange="OnActiveTextBlockChanged">
                                            @foreach (var block in TextBlocks)
                                            {
                                                <option value="@block.Id.ToString("N")">@GetBlockSummary(block)</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="landing-field">
                                        <span>@T("Blokbelyning", "Block alignment")</span>
                                        <select value="@(ActiveTextBlock?.Alignment ?? "left")" @onchange="args => SetActiveTextBlockAlignment(args.Value?.ToString())">
                                            <option value="left">@T("Links", "Left")</option>
                                            <option value="center">@T("Middel", "Center")</option>
                                            <option value="right">@T("Regs", "Right")</option>
                                        </select>
                                    </label>
                                    <div class="landing-rich-editor-shell" @ref="_richTextEditorShell">
                                        @if (_richTextEditorFailed)
                                        {
                                            <button type="button" class="landing-secondary-button landing-rich-editor-retry" @onclick="RetryRichTextEditorAsync">@T("Probeer teksredigeerder weer oopmaak", "Retry opening the text editor")</button>
                                        }
                                        <div class="landing-rich-toolbar" data-editor-label='@T("Landingsbladteksredigeerder", "Landing page text editor")'>
                                            <select class="ql-header" aria-label='@T("Opskrifvlak", "Heading level")'>
                                                <option value="2">@T("Opskrif 2", "Heading 2")</option>
                                                <option value="3">@T("Opskrif 3", "Heading 3")</option>
                                                <option selected>@T("Paragraaf", "Paragraph")</option>
                                            </select>
                                            <button type="button" class="ql-bold" aria-label='@T("Vetdruk", "Bold")'></button>
                                            <button type="button" class="ql-italic" aria-label='@T("Kursief", "Italic")'></button>
                                            <button type="button" class="ql-link" aria-label='@T("Voeg skakel by", "Add link")'></button>
                                            <button type="button" class="ql-list" value="ordered" aria-label='@T("Genommerde lys", "Numbered list")'></button>
                                            <button type="button" class="ql-list" value="bullet" aria-label='@T("Kolpuntlys", "Bulleted list")'></button>
                                        </div>
                                        <div class="landing-rich-editor"
                                             data-placeholder='@T("Skryf jou teks hier...", "Write your text here...")'></div>
                                    </div>
                                </section>
                        </div>

                        <section class="landing-preview-card" aria-label='@T("Regstreekse voorskou", "Live preview")'>
                            <div class="landing-preview-heading">
                                <div>
                                    <h3>@T("Regstreekse voorskou", "Live preview")</h3>
                                    <p>@T("Die voorskou verander saam met jou konsep.", "The preview updates as you edit your draft.")</p>
                                </div>
                                <div class="landing-preview-toggle" role="group" aria-label='@T("Voorskougrootte", "Preview size")'>
                                    <button type="button" class="@(_previewMode == "desktop" ? "is-active" : null)" aria-pressed="@(_previewMode == "desktop")" @onclick='() => SetPreviewMode("desktop")'>@T("Rekenaar", "Desktop")</button>
                                    <button type="button" class="@(_previewMode == "mobile" ? "is-active" : null)" aria-pressed="@(_previewMode == "mobile")" @onclick='() => SetPreviewMode("mobile")'>@T("Selfoon", "Mobile")</button>
                                </div>
                            </div>
                            <div class="landing-preview-stage @(_previewMode == "mobile" ? "is-mobile" : "is-desktop")">
                                <div class="landing-preview-page">
                                    <LandingPageRenderer Content="_workingContent" />
                                </div>
                            </div>
                            <p class="landing-preview-note">@T("Die openbare bladsy sal in 'n sentreerde kolom van hoogstens 640 px verskyn.", "The public page uses a centered column up to 640 px wide.")</p>
                        </section>
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    private const long MaxImageUploadBytes = 10 * 1024 * 1024;
    private const long MaxImagePixelCount = 40_000_000;

    [Parameter]
    public string CurrentLanguageCode { get; set; } = "af";

    private IReadOnlyList<LandingPageRecord> _pages = Array.Empty<LandingPageRecord>();
    private LandingPageRecord? _selectedPage;
    private LandingPageContent? _workingContent;
    private Guid? _selectedPageId;
    private Guid? _activeTextBlockId;
    private string _workingSlug = string.Empty;
    private string _searchText = string.Empty;
    private string _statusFilter = "all";
    private string _previewMode = "desktop";
    private string? _errorMessage;
    private string? _statusMessage;
    private bool _isAuthorized;
    private bool _isLoading = true;
    private bool _loadFailed;
    private bool _isSaving;
    private bool _isPublishing;
    private bool _isUnpublishing;
    private bool _isDeleting;
    private bool _isUploadingImage;
    private bool _hasUnsavedChanges;
    private bool _slugWasManuallyEdited;
    private bool _richTextEditorSyncPending;
    private bool _richTextEditorFailed;
    private long? _workingRevision;
    private Guid _newDraftAssetScopeId = Guid.NewGuid();
    private ElementReference _richTextEditorShell;
    private IJSObjectReference? _richTextEditorModule;
    private DotNetObjectReference<AdminLandingPagesPanel>? _dotNetReference;

    public bool HasUnsavedChanges => _hasUnsavedChanges;

    private bool IsSaving => _isSaving;
    private bool IsPublishing => _isPublishing;
    private bool IsUnpublishing => _isUnpublishing;
    private bool IsUploadingImage => _isUploadingImage;
    private bool IsBusy => _isSaving || _isPublishing || _isUnpublishing || _isDeleting || _isUploadingImage;
    private bool IsSlugLocked => _selectedPage?.HasEverPublished == true;
    private bool CanPublish => !IsBusy && !_hasUnsavedChanges && _selectedPage is not null &&
        (!_selectedPage.IsPublished || _selectedPage.HasUnpublishedChanges) && _workingContent is not null;

    private bool IsR2UploadConfigured
    {
        get
        {
            var options = CloudflareR2OptionsAccessor.Value;
            return !string.IsNullOrWhiteSpace(options.AccountId) &&
                   !string.IsNullOrWhiteSpace(options.BucketName) &&
                   !string.IsNullOrWhiteSpace(options.AccessKeyId) &&
                   !string.IsNullOrWhiteSpace(options.SecretAccessKey) &&
                   Uri.TryCreate(options.PublicBaseUrl, UriKind.Absolute, out var publicBaseUri) &&
                   string.Equals(publicBaseUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);
        }
    }

    private IReadOnlyList<LandingPageRecord> FilteredPages => _pages
        .Where(MatchesStatusFilter)
        .Where(MatchesSearch)
        .OrderByDescending(page => page.UpdatedAt)
        .ThenBy(page => page.Draft.Title, StringComparer.OrdinalIgnoreCase)
        .ToArray();

