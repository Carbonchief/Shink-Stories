    private async Task ReloadAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        _errorMessage = null;

        try
        {
            _isAuthorized = await LandingPageAdminService.EnsureAdminAsync();
            if (!_isAuthorized)
            {
                _pages = Array.Empty<LandingPageRecord>();
                return;
            }

            _pages = await LandingPageAdminService.GetPagesAsync();
        }
        catch (Exception exception)
        {
            _loadFailed = true;
            Logger.LogError(exception, "Could not load landing pages for the admin panel.");
            _errorMessage = GetOperationError(exception, T("Landingsbladsye kon nie laai nie.", "Landing pages could not be loaded."));
        }
        finally
        {
