    {
        SchemaVersion = 1,
        Title = string.Empty,
        BackgroundColor = "#ff7133",
        TextColor = "#ffffff",
        SharingTitle = string.Empty,
        SharingDescription = string.Empty,
        Blocks =
        [
            new LandingPageBlock { Type = "image", ImageShape = "square", Alignment = "center" },
            new LandingPageBlock { Type = "text", Html = "<p></p>", Alignment = "left" },
            new LandingPageBlock { Type = "button", Text = T("Lees meer", "Learn more"), Url = string.Empty, BackgroundColor = "#222222", TextColor = "#ffffff", Alignment = "center" }
        ]
    };

    private static LandingPageContent CloneContent(LandingPageContent content) => new()
    {
        SchemaVersion = content.SchemaVersion,
        Title = content.Title ?? string.Empty,
        BackgroundColor = content.BackgroundColor ?? "#ff7133",
        TextColor = content.TextColor ?? "#ffffff",
        SharingTitle = content.SharingTitle ?? string.Empty,
        SharingDescription = content.SharingDescription ?? string.Empty,
        Blocks = content.Blocks?.Select(block => new LandingPageBlock
        {
            Id = block.Id == Guid.Empty ? Guid.NewGuid() : block.Id,
            Type = block.Type ?? "text",
            ImageUrl = block.ImageUrl ?? string.Empty,
            AltText = block.AltText ?? string.Empty,
            ImageShape = block.ImageShape ?? "square",
            Html = block.Html ?? string.Empty,
            Alignment = block.Alignment ?? "left",
            Text = block.Text ?? string.Empty,
            Url = block.Url ?? string.Empty,
            LinkType = block.LinkType ?? string.Empty,
            BackgroundColor = block.BackgroundColor ?? string.Empty,
            TextColor = block.TextColor ?? string.Empty
        }).ToList() ?? []
    };

    private static string CreateSlug(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);
        var previousWasSeparator = true;
        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) == UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsAsciiLetterOrDigit(character))
            {
                builder.Append(char.ToLowerInvariant(character));
                previousWasSeparator = false;
            }
            else if (!previousWasSeparator)
            {
                builder.Append('-');
                previousWasSeparator = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private static string ColorOrDefault(string? color, string fallback) =>
        !string.IsNullOrWhiteSpace(color) && System.Text.RegularExpressions.Regex.IsMatch(color.Trim(), "^#[0-9a-fA-F]{6}$")
            ? color.Trim()
            : fallback;

    private static string NormalizeAlignment(string? alignment) => alignment?.Trim().ToLowerInvariant() switch
    {
        "center" => "center",
        "right" => "right",
        _ => "left"
    };

    private void MarkChanged()
    {
        _hasUnsavedChanges = true;
        _statusMessage = null;
    }

    private Task RetryRichTextEditorAsync()
    {
        _richTextEditorFailed = false;
        _richTextEditorSyncPending = ActiveTextBlock is not null;
        _errorMessage = null;
        return InvokeAsync(StateHasChanged);
    }

    private string GetResultError(string? errorCode, string fallback) => errorCode switch
    {
        LandingPageErrorCodes.AdminRequired => T("Jou adminregte kon nie bevestig word nie.", "Your admin access could not be confirmed."),
        LandingPageErrorCodes.SupabaseNotConfigured => T("Die bestuursdatabasis is nie opgestel nie.", "The admin database is not configured."),
        LandingPageErrorCodes.SchemaNotReady => T("Die landingsblad-databasisskema is nog nie beskikbaar nie.", "The landing page database schema is not ready yet."),
        LandingPageErrorCodes.SlugInvalid => T("Die slug moet kleinletters, syfers en koppeltekens bevat.", "The slug must use lowercase letters, numbers, and hyphens."),
        LandingPageErrorCodes.SlugTaken => T("Daardie slug word reeds gebruik.", "That slug is already in use."),
        LandingPageErrorCodes.SlugImmutable => T("'n Gepubliseerde bladsy se slug kan nie verander word nie.", "A published page's slug cannot be changed."),
        LandingPageErrorCodes.ContentInvalid => T("Kontroleer die titel, kleure, blokke en skakels voordat jy stoor.", "Check the title, colors, blocks, and links before saving."),
        LandingPageErrorCodes.PublishValidationFailed => T("Voeg 'n geldige titel en ten minste een volledige inhoudsblok by voordat jy publiseer.", "Add a valid title and at least one complete content block before publishing."),
        LandingPageErrorCodes.PageNotFound => T("Hierdie bladsy bestaan nie meer nie. Verfris die lys.", "This page no longer exists. Refresh the list."),
        LandingPageErrorCodes.PageNotPublished => T("Hierdie bladsy is reeds ontpubliseer.", "This page has already been unpublished."),
        LandingPageErrorCodes.RevisionRequired or LandingPageErrorCodes.RevisionConflict => T("Hierdie bladsy is intussen verander. Verfris die bladsy en pas jou veranderinge weer toe.", "This page changed while you were editing. Refresh it and reapply your changes."),
        _ => fallback
    };

    private string GetOperationError(Exception exception, string fallback) => exception is LandingPageServiceException landingException
        ? GetResultError(landingException.ErrorCode, fallback)
        : exception.Message switch
        {
            "unsupported_image_format" => T("Kies 'n geldige JPEG-, PNG- of WebP-prent.", "Choose a valid JPEG, PNG, or WebP image."),
            "image_dimensions_invalid" => T("Die prent is ongeldig of groter as die toegelate 40 megapixels.", "The image is invalid or exceeds the 40-megapixel limit."),
            "image_decode_failed" => T("Die prentlêer kon nie volledig gelees word nie.", "The image file could not be decoded."),
            "Cloudflare R2 is not fully configured for admin uploads." => T("Cloudflare R2 is nie opgestel vir prentoplaaie nie.", "Cloudflare R2 is not configured for image uploads."),
            _ => fallback
        };

    private string T(string afrikaans, string english) =>
        string.Equals(CurrentLanguageCode, "en", StringComparison.OrdinalIgnoreCase) ? english : afrikaans;

    public async ValueTask DisposeAsync()
    {
        _dotNetReference?.Dispose();
        if (_richTextEditorModule is not null)
        {
            try
            {
                await _richTextEditorModule.InvokeVoidAsync("disposeRichTextEditor", _richTextEditorShell);
                await _richTextEditorModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disconnected.
            }
        }
    }

    private sealed record ValidatedLandingImage(MemoryStream Content, string ContentType, string Extension);
