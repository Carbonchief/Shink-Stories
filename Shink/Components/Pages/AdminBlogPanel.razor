            "Die blog slug is ongeldig." => T("Die blog slug is ongeldig.", "The blog slug is invalid."),
            "Blog inhoud is verpligtend." => T("Die blog inhoud is verpligtend.", "The blog content is required."),
            "Die blog slug bestaan reeds." => T("Die blog slug bestaan reeds.", "The blog slug already exists."),
            "Kon nie blog pos nou opdateer nie." => T("Kon nie blog plasing nou opdateer nie.", "Could not update the blog post right now."),
            "Kon nie blog pos nou skep nie." => T("Kon nie blog plasing nou skep nie.", "Could not create the blog post right now."),
            "Kon nie blog etikette nou stoor nie." => T("Kon nie blog etikette nou stoor nie.", "Could not save the blog tags right now."),
            "Kon nie blog pos nou stoor nie." => T("Kon nie blog plasing nou stoor nie.", "Could not save the blog post right now."),
            "Kies asseblief 'n geldige blog pos." => T("Kies asseblief 'n geldige blog plasing.", "Please choose a valid blog post."),
