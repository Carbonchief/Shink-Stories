    private async Task<string> UploadInlineImageAsync(string slug, IBrowserFile file)
    {
        var normalizedContentType = NormalizeImageContentType(file);
        if (IsR2UploadConfigured)
        {
            var directUpload = await StoryMediaStorageService.CreateImageDirectUploadAsync(
                $"blog-{slug}",
                StoryImageKind.Inline,
                file.Name,
                normalizedContentType);

            try
            {
                await UploadSelectedFileToR2Async(InlineImageInputId, directUpload);
                return directUpload.PublicUrl
                       ?? throw new InvalidOperationException("Direct inline image upload did not provide a public URL.");
            }
            catch (Exception exception)
            {
                Logger.LogWarning(
                    exception,
                    "Direct inline image upload failed for blog {BlogSlug}. Falling back to server-side upload.",
                    slug);

                await using var stream = file.OpenReadStream(MaxImageUploadBytes);
                var uploaded = await StoryMediaStorageService.UploadImageAsync(
                    $"blog-{slug}",
                    StoryImageKind.Inline,
                    file.Name,
                    normalizedContentType,
                    stream);
                return uploaded.PublicUrl;
            }
        }

        var localUpload = await SaveInlineImageToLocalAsync(slug, file);
        return localUpload.PublicPath;
    }

    private async Task<string> UploadCloudflareVideoAsync(string slug, IBrowserFile file)
    {
        var directUpload = await StoryMediaStorageService.CreateVideoDirectUploadAsync(
            $"blog-{slug}",
            file.Name,
            NormalizeVideoContentType(file));
        await UploadSelectedFileToR2Async(CloudflareVideoInputId, directUpload);
        return directUpload.PublicUrl
               ?? throw new InvalidOperationException("Direct video upload did not provide a public URL.");
    }

