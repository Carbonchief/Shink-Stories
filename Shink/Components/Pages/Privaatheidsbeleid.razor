@page "/privaatheidsbeleid"
@page "/privacy"
@page "/privacy-policy"

@inject NavigationManager NavigationManager

<PageTitle>Schink Stories | Privaatheidsbeleid</PageTitle>
<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    <meta name="description" content="Schink Stories se privaatheidsbeleid vir ons webwerf en mobiele toepassing." />
    <meta name="robots" content="index,follow" />
</HeadContent>

<article class="legal-page">
    <header class="legal-hero">
        <p class="legal-kicker">Jou privaatheid</p>
        <h1>Privaatheidsbeleid</h1>
        <p class="legal-updated">Laas opgedateer: 31 Augustus 2026</p>
        <p>
            Hierdie beleid verduidelik hoe SCHINK PTY. LTD. ("Schink Stories", "ons" of "ons s'n")
            persoonlike inligting hanteer wanneer jy ons webwerf, mobiele toepassing, oudiostories,
            winkel en intekeningdienste gebruik.
        </p>
    </header>

    <section>
        <h2>Wie die diens gebruik</h2>
        <p>
            Schink Stories is gesinsinhoud vir kinders, maar rekeninge, intekeninge en aankope moet deur 'n
            ouer, voog of ander volwassene bestuur word. Ons vra kinders nie om self 'n rekening te skep,
            betalingsbesonderhede te verskaf of persoonlike inligting aan ons te stuur nie.
        </p>
    </section>

    <section>
        <h2>Inligting wat ons verwerk</h2>
        <ul>
            <li><strong>Rekening en kontak:</strong> jou naam, vertoonnaam, e-posadres, selfoonnommer en aanmeldverskaffer.</li>
            <li><strong>Intekening en aankope:</strong> plan, winkelproduk, transaksiestatus, verwysing, bedrag en toegangstatus. Ons stoor nie jou volle kaartbesonderhede nie.</li>
            <li><strong>Gebruik en vordering:</strong> stories wat oopgemaak, geluister, voltooi, afgelaai of as gunsteling gemerk is; soektogte; karakter- en speletjieaktiwiteit; en kennisgewingstatus.</li>
            <li><strong>Tegniese en diagnostiese data:</strong> toesteltipe, vervaardiger, bedryfstelsel, toepassingweergawe, netwerkstatus, 'n ewekansige analitiese identifiseerder, fouttipe en basiese versoekinligting soos IP-adres en sekuriteitslogboeke.</li>
            <li><strong>Kommunikasie:</strong> besonderhede wat jy self deur ons kontakvorms, ondersteuningsversoeke of e-posse verskaf.</li>
        </ul>
    </section>

    <section>
        <h2>Waarom ons dit gebruik</h2>
        <ul>
            <li>om jou rekening te verifieer en die regte stories en intekeningstoegang te gee;</li>
            <li>om luistervordering, gunstelinge, aflaaie en gesinsfunksies te laat werk;</li>
            <li>om aankope, hernuwings, kansellasies, terugbetalings en kliëntediens te hanteer;</li>
            <li>om die diens veilig, betroubaar en vinnig te hou en tegniese probleme op te spoor;</li>
            <li>om saamgestelde gebruikspatrone te verstaan en Schink Stories te verbeter; en</li>
            <li>om wettige, rekening- of diensboodskappe te stuur, en bemarking slegs waar jy daarvoor gekies het.</li>
        </ul>
        <p>Ons verkoop nie persoonlike inligting nie en gebruik dit nie vir advertensies oor ander maatskappye se programme of webwerwe nie.</p>
    </section>

    <section>
        <h2>Diensverskaffers</h2>
        <p>Ons gebruik sorgvuldig gekose verskaffers net om die diens te lewer:</p>
        <ul>
            <li><strong>Supabase</strong> vir aanmelding, rekeningdata en databasisdienste;</li>
            <li><strong>Apple en Google</strong> vir opsionele aanmelding en winkelbetalings in die mobiele toepassing;</li>
            <li><strong>Paystack</strong> vir webbetalings en intekeninge;</li>
            <li><strong>PostHog</strong> vir produkontleding en foutdiagnose;</li>
            <li><strong>Cloudflare</strong> vir veilige inhoudaflewering, media en netwerkbeskerming; en</li>
            <li><strong>Resend</strong> vir rekening-, diens- en gekose bemarkings-e-posse.</li>
        </ul>
        <p>
            Hierdie verskaffers kan data buite Suid-Afrika verwerk. Ons beperk die data tot wat nodig is en
            gebruik verskaffers se kontraktuele en sekuriteitsmaatreëls om dit te beskerm.
        </p>
    </section>

    <section>
        <h2>Bewaring en sekuriteit</h2>
        <p>
            Ons hou data net so lank as wat dit redelik nodig is vir jou rekening, dienslewering, veiligheid,
            belasting, boekhouding en wetlike verpligtinge. Data word tydens oordrag deur HTTPS beskerm.
            Geen stelsel is heeltemal risikovry nie, maar ons gebruik toegangbeheer, beperkte sleutels,
            beveiligde sessies en monitering om die risiko te verminder.
        </p>
    </section>

    <section>
        <h2>Jou keuses en regte</h2>
        <p>
            Jy kan vra om jou persoonlike inligting te sien, reg te stel, uit te voer, beswaar te maak teen
            sekere verwerking of dit te laat verwyder, onderhewig aan toepaslike wetlike bewaring. Jy kan jou
            profiel in die toepassing wysig en 'n rekeningverwyderingsversoek vanuit Instellings begin.
        </p>
        <p>
            Lees die <a href="/rekening-verwydering">rekeningverwyderingsblad</a> vir die stappe en watter data
            moontlik vir wetlike rekordhouding behou moet word.
        </p>
    </section>

    <section>
        <h2>Kontak ons</h2>
        <p>
            Vir privaatheidsvrae of versoeke, gebruik die <a href="/#kontak-ons">Schink Stories-kontakvorm</a>
            en kies 'n onderwerp wat duidelik "Privaatheid" of "Rekeningverwydering" bevat. Die verantwoordelike
            entiteit is SCHINK PTY. LTD., Suid-Afrika.
        </p>
    </section>
</article>

@code {
    private string CanonicalUrl => NavigationManager.ToAbsoluteUri("/privaatheidsbeleid").ToString();
}
