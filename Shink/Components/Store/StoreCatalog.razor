<header class="winkel-catalog-heading">
    <p class="winkel-section-kicker">Uit ons storiewêreld. Met liefde.</p>
    <h1 id="winkel-produkte">'n Maatjie vir elke <span>storie.</span></h1>
    <p>Bekende karakters vir storietyd, speeltyd en elke knuffel tussenin.</p>
</header>
<section class="winkel-products" aria-labelledby="winkel-produkte">
    @if (Products.Count > 0)
    {
        <div class="winkel-catalog-browser" data-store-filters>
            <div class="winkel-catalog-toolbar">
                <button class="winkel-filter-toggle" type="button" data-store-filter-toggle aria-controls="winkel-filters" aria-expanded="true">
                    <i class="fa-solid fa-sliders" aria-hidden="true"></i> Filters
                    <i class="fa-solid fa-chevron-down winkel-filter-chevron" aria-hidden="true"></i>
                </button>
                <p class="winkel-results-count" data-store-results role="status" aria-live="polite">@Products.Count produkte</p>
                <label class="winkel-search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <span class="sr-only">Soek produkte</span>
                    <input class="ph-no-capture" type="search" placeholder="Soek produkte…" data-store-search autocomplete="off" />
                </label>
            </div>
            <div class="winkel-catalog-layout" data-store-catalog-layout data-filters="open">
                <aside class="winkel-sidebar" id="winkel-filters" data-store-filter-panel aria-label="Produkfilters">
                    <fieldset class="winkel-filter-group">
                        <legend>Sorteer volgens</legend>
                        <label><input type="radio" name="winkel-sort" value="featured" data-store-sort checked /> Uitgesoek vir jou</label>
                        <label><input type="radio" name="winkel-sort" value="name" data-store-sort /> Naam: A–Z</label>
                        <label><input type="radio" name="winkel-sort" value="name-desc" data-store-sort /> Naam: Z–A</label>
                        <label><input type="radio" name="winkel-sort" value="price-asc" data-store-sort /> Prys: laag na hoog</label>
                        <label><input type="radio" name="winkel-sort" value="price-desc" data-store-sort /> Prys: hoog na laag</label>
                    </fieldset>
                    <fieldset class="winkel-filter-group">
                        <legend>Versameling</legend>
                        <label class="winkel-collection-option"><input type="radio" name="winkel-collection" value="" data-store-collection checked /><span>Alle produkte</span><small>@Products.Count</small></label>
                        @foreach (var collection in StoreProductCollections.All)
                        {
                            var count = Products.Count(product => product.CollectionSlug == collection.Slug);
                            <label class="winkel-collection-option"><input type="radio" name="winkel-collection" value="@collection.Slug" data-store-collection /><span>@collection.Name</span><small>@count</small></label>
                        }
                    </fieldset>
                    <fieldset class="winkel-filter-group">
                        <legend>Aflewering</legend>
                        <label><input type="checkbox" data-store-free-filter /> Aflewering ingesluit</label>
                        <p>Kwalifiserende maatjies sluit aflewering vir jou hele bestelling in.</p>
                    </fieldset>
                    <div class="winkel-sidebar-story">
                        <img src="/branding/characters/thumbs/suurlemoentjie.webp" alt="" width="72" height="72" loading="lazy" decoding="async" />
                        <p>Elke maatjie het 'n storie.</p>
                        <a href="/luister">Kom luister saam <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </aside>
                <div class="winkel-catalog-results">
                    <div class="winkel-grid" data-store-grid>
                        @foreach (var product in Products)
                        {
                            <StoreProductCard @key="product.Slug" Product="product" />
                        }
                    </div>
                    <div class="winkel-empty" data-store-no-results hidden>
                        <i class="fa-regular fa-face-smile" aria-hidden="true"></i>
                        <h2>Geen produkte pas by jou soektog nie.</h2>
                        <p>Probeer 'n ander naam of wys weer al die produkte.</p>
                        <button class="winkel-secondary" type="button" data-store-reset-filters>Wys alle produkte</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="winkel-empty"><h3>Nuwe maatjies is op pad.</h3><p>Ons werk tans aan ons produkte. Kyk asseblief weer oor 'n rukkie.</p></div>
    }
</section>
<section class="winkel-help">
    <div><p class="winkel-section-kicker">Van storietyd tot knuffeltyd</p><h2>Die stories word deel van hulle wêreld.</h2><p>Ontmoet die karakters, luister na hulle avonture en kies 'n maatjie om naby te hou.</p></div>
    <a class="winkel-secondary" href="/luister"><i class="fa-solid fa-headphones" aria-hidden="true"></i> Ontdek die stories</a>
</section>
<StoreBenefits />
<StoreQuickView />

@code {
    [Parameter] public IReadOnlyList<StoreProduct> Products { get; set; } = [];
}
